}
function showAuth(mode='signin'){$('authSection').classList.remove('hidden');setAuthMode(mode);$('authSection').scrollIntoView({behavior:'smooth',block:'start'});}
function setAuthMode(mode){authMode=mode;const sign=mode==='signin';$('signinTab').classList.toggle('active',sign);$('signupTab').classList.toggle('active',!sign);$('authTitle').textContent=sign?'Sign in to your account':'Create your account';$('authSubmit').textContent=sign?'Login':'Create account';$('authNameWrap').classList.toggle('hidden',sign);$('authPassword').autocomplete=sign?'current-password':'new-password';$('authMessage').textContent='';}
function updateSessionUI(){const logged=!!currentUser;$('loginNav').classList.toggle('hidden',logged);$('signupNav').classList.toggle('hidden',logged);$('logoutBtn').classList.toggle('hidden',!logged);$('bookingNotice').textContent=logged?`Signed in as ${currentUser.email}. Your booking request will be linked to your account.`:'Please sign in before submitting a booking request.';if(logged)loadBookings();else $('myBookings').innerHTML='<div class="empty">Sign in to view your bookings.</div>';}
async function loadWorkers(){const grid=$('workerGrid');grid.innerHTML='<div class="empty">Loading available professionals…</div>';try{const {data,error}=await supabaseClient.from('public_worker_directory').select('id,full_name,service,price,area,postal_code,photo_url,available').order('full_name');if(error)throw error;workers=data||[];$('bookingWorker').innerHTML='<option value="">Let me choose later</option>'+workers.map(w=>`<option value="${safe(w.id)}">${safe(w.full_name)} — ${safe(w.service)}</option>`).join('');grid.innerHTML=workers.length?workers.map(w=>`<article class="worker-card"><img class="worker-photo" src="${safe(w.photo_url||'https://placehold.co/200x200/f0ebff/29213d?text=Pro')}" alt="${safe(w.full_name)}" loading="lazy" onerror="this.src='https://placehold.co/200x200/f0ebff/29213d?text=Pro'"><div class="worker-info"><h3>${safe(w.full_name)}</h3><p>${safe(w.service||'Home professional')}</p><p>⌖ ${safe(w.area||'Local area')}${w.postal_code?' · '+safe(w.postal_code):''}</p><div class="price">${w.price!=null?'₹'+Number(w.price).toLocaleString('en-IN'):'Price on request'}</div><span class="pill">Available</span></div><button type="button" class="btn btn-light choose-worker" data-worker="${safe(w.id)}" data-service="${safe(w.service)}">Book</button></article>`).join(''):'<div class="empty">No approved professionals are available yet. Please check again later.</div>';}catch(e){console.error(e);grid.innerHTML='<div class="empty">Could not load professionals. Check that public_worker_directory allows public SELECT and that the view contains the listed columns.</div>';}}
async function loadBookings(){if(!currentUser)return;const box=$('myBookings');box.innerHTML='<div class="empty">Loading your bookings…</div>';try{const {data,error}=await supabaseClient.from('bookings').select('id,service,address,postal_code,booking_date,notes,status,created_at').eq('customer_id',currentUser.id).order('created_at',{ascending:false});if(error)throw error;box.innerHTML=data?.length?data.map(b=>`<article class="booking-item"><div><h4>${safe(b.service)}</h4><p>📅 ${safe(b.booking_date||'Date not set')} · PIN ${safe(b.postal_code||'—')}</p><p>⌖ ${safe(b.address||'Address not set')}</p>${b.notes?`<p>${safe(b.notes)}</p>`:''}</div><span class="status ${safe((b.status||'pending').toLowerCase())}">${safe(b.status||'Pending')}</span></article>`).join(''):'<div class="empty">No bookings yet. Choose a service above to get started.</div>';}catch(e){console.error(e);box.innerHTML='<div class="empty">Bookings could not be loaded. Check the bookings table and its SELECT policy for signed-in customers.</div>';}}
$('serviceGrid').addEventListener('click',e=>{const btn=e.target.closest('[data-service]');if(!btn)return;selectedService=btn.dataset.service;renderServices($('serviceSearch').value);$('bookingService').value=selectedService;$('booking').scrollIntoView({behavior:'smooth'});});
$('workerGrid').addEventListener('click',e=>{const btn=e.target.closest('.choose-worker');if(!btn)return;$('bookingWorker').value=btn.dataset.worker;const service=SERVICES.find(s=>s.name.toLowerCase()===btn.dataset.service.toLowerCase())?.name||btn.dataset.service;selectedService=service;renderServices($('serviceSearch').value);$('bookingService').value=service;$('booking').scrollIntoView({behavior:'smooth'});});
$('searchBtn').addEventListener('click',()=>{renderServices($('serviceSearch').value.trim());$('services').scrollIntoView({behavior:'smooth'});});$('serviceSearch').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();$('searchBtn').click();}});$('serviceSearch').addEventListener('input',e=>renderServices(e.target.value));
$('promoBook').onclick=()=>$('booking').scrollIntoView({behavior:'smooth'});$('refreshWorkers').onclick=loadWorkers;$('refreshBookings').onclick=loadBookings;$('loginNav').onclick=()=>showAuth('signin');$('signupNav').onclick=()=>showAuth('signup');$('footerLogin').onclick=e=>{e.preventDefault();showAuth('signin')};$('signinTab').onclick=()=>setAuthMode('signin');$('signupTab').onclick=()=>setAuthMode('signup');$('menuBtn').onclick=()=>$('navlinks').classList.toggle('open');document.querySelectorAll('.navlinks a,.bottom-nav a').forEach(a=>a.addEventListener('click',()=>$('navlinks').classList.remove('open')));
$('authForm').addEventListener('submit',async e=>{e.preventDefault();const msg=$('authMessage');const email=$('authEmail').value.trim();const password=$('authPassword').value;const name=$('authName').value.trim();msg.textContent='Please wait…';$('authSubmit').disabled=true;try{let result;if(authMode==='signup'){result=await supabaseClient.auth.signUp({email,password,options:{data:{full_name:name}}});}else{result=await supabaseClient.auth.signInWithPassword({email,password});}if(result.error)throw result.error;if(authMode==='signup'&&!result.data.session){msg.textContent='Account created. Check your email for the confirmation link, then log in.';}else{msg.textContent='Success! You are signed in.';$('authSection').classList.add('hidden');currentUser=result.data.user;updateSessionUI();await loadBookings();}}catch(err){msg.textContent=err.message||'Authentication failed. Please try again.';}finally{$('authSubmit').disabled=false;}});
$('logoutBtn').onclick=async()=>{const {error}=await supabaseClient.auth.signOut();if(error){alert(error.message);return;}currentUser=null;updateSessionUI();};
$('bookingForm').addEventListener('submit',async e=>{e.preventDefault();const msg=$('bookingMessage');if(!currentUser){msg.textContent='Please login or create an account first.';showAuth('signin');return;}const service=$('bookingService').value;const address=$('bookingAddress').value.trim();const postal_code=$('postalCode').value.trim();const booking_date=$('bookingDate').value;const notes=$('bookingNotes').value.trim();const workerVal=$('bookingWorker').value;const worker_id=workerVal||null;if(!service||!address||!/^[0-9]{6}$/.test(postal_code)||!booking_date){msg.textContent='Please complete all required fields and enter a 6-digit PIN code.';return;}msg.textContent='Sending your booking request…';$('submitBooking').disabled=true;try{const payload={customer_id:currentUser.id,worker_id,service,address,postal_code,booking_date,notes,status:'Pending'};const {error}=await supabaseClient.from('bookings').insert(payload);if(error)throw error;msg.textContent='Booking request submitted! Check My Bookings for its status.';$('bookingForm').reset();selectedService='';renderServices($('serviceSearch').value);await loadBookings();$('my-bookings').scrollIntoView({behavior:'smooth'});}catch(err){console.error(err);msg.textContent='Booking could not be saved: '+(err.message||'Please check your Supabase bookings table and INSERT policy.');}finally{$('submitBooking').disabled=false;}});
(async function init(){renderServices();$('year').textContent=new Date().getFullYear();const today=new Date();$('bookingDate').min=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);try{const {data}=await supabaseClient.auth.getSession();currentUser=data.session?.user||null;}catch(e){console.error(e)}updateSessionUI();await loadWorkers();supabaseClient.auth.onAuthStateChange((_event,session)=>{currentUser=session?.user||null;updateSessionUI();});})();
</script>
</body></html>
